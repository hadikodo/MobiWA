{
  "manifest_version": 3,
  "name": "MobiWA Connector",
  "short_name": "MobiWA",
  "version": "1.0.0",
  "description": "Connects the MobiWA web app (app.mobiwa.com) to WhatsApp Web to collect numbers, sort chats with AI and send your messages.",
  "homepage_url": "https://mobiwa.com/extension",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "MobiWA Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://app.mobiwa.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.mobiwa.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
